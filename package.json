{
  "name": "apc-clone",
  "version": "2.4.13",
  "description": "APC Clone - Banking document automation tool for generating Word files",
  "author": "Thanhdn1984",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5000 && cross-env NODE_ENV=development electron .\"",
    "dev": "vite",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "electron:dev": "npm start",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable",
    "deploy": "npm run build && electron-builder --publish always",
    "clean": "rimraf dist release-builds node_modules/.vite node_modules/.electron-builder",
    "clean:builds": "rimraf release-builds",
    "release": "npm run clean && npm run deploy",
    "release:safe": "npm run clean && npm run build && electron-builder --publish always",
    "safe-build": "powershell -ExecutionPolicy Bypass -File ./scripts/safe-build.ps1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Thanhdn1984/docxautomator.git"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xmldom/xmldom": "^0.8.10",
    "angular-expressions": "^1.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docxtemplater": "^3.67.5",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.344.0",
    "pizzip": "^3.2.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.35",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.13",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.apc.clone",
    "productName": "APC Clone",
    "files": [
      "dist",
      "electron",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release-builds"
    },
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Thanhdn1984",
      "repo": "apc-clone"
    }
  }
}
